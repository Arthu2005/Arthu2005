# ---------------------------------------------------------------
# PETROLUB — variáveis de ambiente (copie para .env.local)
# Nunca faça commit de .env / .env.local com valores reais.
# ---------------------------------------------------------------

# PostgreSQL (local, Supabase, Neon, RDS…)
# Supabase: use a "connection string" do pooler (porta 6543) e DATABASE_PREPARE=false
DATABASE_URL=postgres://petrolub:petrolub_dev@localhost:5432/petrolub
DATABASE_POOL_MAX=10
DATABASE_PREPARE=true

# URL pública do site (sitemap, links em e-mails, Open Graph)
APP_URL=http://localhost:3000

# Segredo usado para pseudonimizar IPs e assinar tokens de formulário.
# Gere com: openssl rand -base64 48
APP_SECRET=troque-este-valor-por-um-segredo-aleatorio-com-48-bytes

# Cookies "Secure" (true em produção com HTTPS)
COOKIE_SECURE=false

# Armazenamento de arquivos (currículos e mídia)
#   local: disco do servidor, fora de /public (bom para VPS/Docker com volume persistente)
#   s3:    bucket S3-compatível PRIVADO (Supabase Storage S3, Cloudflare R2, AWS S3, MinIO)
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./storage
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=true
UPLOAD_MAX_MB=5

# E-mail transacional (opcional). Sem SMTP o site funciona, mas não envia e-mails.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="PETROLUB <nao-responda@petrolub.com.br>"
RECRUITING_NOTIFY_EMAIL=
CONTACT_NOTIFY_EMAIL=

# Cloudflare Turnstile (opcional, antispam adicional)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Google Analytics 4 (opcional; só carrega após consentimento de cookies)
NEXT_PUBLIC_GA_ID=
