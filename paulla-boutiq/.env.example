# Todas as variáveis são opcionais — sem elas a vitrine usa os dados locais de src/data.

# Número de WhatsApp para atendimento (somente dígitos, com DDI + DDD). Ex.: 5511999999999
# Se vazio, os botões de atendimento direcionam para o Instagram.
VITE_WHATSAPP_NUMBER=

# URL de um JSON com o catálogo (mesmo formato de src/data/products.ts). Se falhar, usa o catálogo local.
VITE_CATALOG_URL=

# Endpoint (POST JSON { email }) para a assinatura de novidades. Se vazio, a inscrição abre o Direct do Instagram.
VITE_NEWSLETTER_ENDPOINT=
